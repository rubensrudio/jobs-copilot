# App
ENV=development
FRONTEND_URL=http://localhost:4200
COOKIE_SECURE=false

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=jobs_copilot

# Session
SESSION_SECRET=
SESSION_TTL_DAYS=14

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Admin bootstrap
BOOTSTRAP_ADMIN_EMAILS=

# Terms of use
TERMS_VERSION=2026-10-01

# LLM
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_S=25
EMBEDDING_MODEL=text-embedding-3-smal
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=
EMBEDDING_PRICE_PER_MTOK=

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX=jobs-copilot

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5001

# Cost caps (USD)
DEFAULT_USER_COST_CAP_USD=5.0
DEFAULT_GLOBAL_COST_CAP_USD=50.0
ANALYSIS_COST_ESTIMATE_USD=0.05
CV_COST_ESTIMATE_USD=0.05

# Analysis limits
MAX_POSTING_CHARS=30000
ANALYSIS_TIMEOUT_S=60

# Collection
COLLECTOR_TOKEN=
GREENHOUSE_BOARDS=